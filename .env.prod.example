# ============================================================
# PTDARRAHMAN — PRODUCTION ENV (VPS)
# ============================================================
# Salin ke `.env.prod` lalu isi SEMUA nilai bertanda WAJIB.
#   cp .env.prod.example .env.prod
#
# Dipakai oleh: docker compose --env-file .env.prod -f docker-compose.prod.yml ...
# (.env.prod TIDAK di-commit — sudah masuk .gitignore)
#
# CATATAN: file ini HANYA untuk infrastruktur (domain, build URL, port).
# Rahasia aplikasi tetap di apps/api/.env dan apps/whatsapp/.env.
# ============================================================

# ── Domain publik (WAJIB) ────────────────────────────────────────────────────
# Satu subdomain per aplikasi (boleh beda registrable domain).
# Domain ini otomatis dipakai nginx untuk routing + penerbitan sertifikat.
DOMAIN_COMPANYPROFILE=ptdarrahman.example.com
DOMAIN_PPDB=ppdb.ptdarrahman.example.com
DOMAIN_SUPERADMIN=admin.ptdarrahman.example.com
DOMAIN_API=api.ptdarrahman.example.com

# ── URL publik (WAJIB) ───────────────────────────────────────────────────────
# HARUS https dan HARUS sama dengan domain di atas. Nilai ini di-bake ke
# bundle frontend saat build, jadi kalau diubah wajib `up -d --build`.
PUBLIC_API_URL=https://api.ptdarrahman.example.com
PUBLIC_PPDB_URL=https://ppdb.ptdarrahman.example.com
PUBLIC_COMPANYPROFILE_URL=https://ptdarrahman.example.com
# Opsional: API cadangan (Next `fetchWithFallback`). Kosongkan bila tidak ada.
PUBLIC_FALLBACK_API_URL=

# ── TLS (Let's Encrypt) ──────────────────────────────────────────────────────
# Email untuk notifikasi kadaluarsa sertifikat. Dipakai script penerbitan.
LETSENCRYPT_EMAIL=admin@ptdarrahman.example.com

# ── Port publik nginx ────────────────────────────────────────────────────────
# Biarkan 80/443 kecuali ada proxy/host lain di depan.
HTTP_PORT=80
HTTPS_PORT=443

# ── Runtime API ──────────────────────────────────────────────────────────────
# production = backend menegakkan JWT/CRON secret + kredensial Pakasir.
APP_ENV=production
