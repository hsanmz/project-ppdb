# ============================================================
# Root .dockerignore — berlaku untuk build context repository ROOT
# (dipakai oleh docker-compose service `frontend` via docker/Dockerfile.frontend).
# Service api/whatsapp memakai context mereka sendiri (.dockerignore masing-masing).
# ============================================================

# Secrets — jangan pernah masuk image
.env
.env.*
!.env.example

# Git / tooling
.git
.gitignore
.gitattributes
.turbo
coverage

# Node / build artifacts
node_modules
.pnpm-store
dist
.next
*.tsbuildinfo
*.log

# Nested build artifacts — context root dipakai oleh Dockerfile.web &
# Dockerfile.companyprofile. Tanpa pola `**/` ini, node_modules/dist/.next
# milik host (hasil `pnpm dev`/`pnpm build`) ikut terkirim ke context build.
**/node_modules
**/.pnpm-store
**/dist
**/.next
**/.turbo
**/coverage
**/*.tsbuildinfo

# Backend & WhatsApp service — TIDAK diperlukan oleh container frontend
apps/api
apps/whatsapp

# Python artifacts (jika ada di root kebetulan)
.venv
venv
__pycache__
*.pyc
.mypy_cache
.ruff_cache

# Nested Python artifacts
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache

# Docker config sendiri
Dockerfile
.dockerignore
docker-compose*.yml
